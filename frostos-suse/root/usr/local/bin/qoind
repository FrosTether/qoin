#!/bin/sh
#
# qoind — FrostBSD / FrostOS Qoin core service (Stage 1 scaffold).
#
# HONEST SCOPE: manages the local Qoin data directory, self-provisions an
# on-device wallet on first run, and heartbeats. It does NOT network, run
# consensus, mine, or issue coins — that is Stage 3.
#
# SELF-PROVISIONING ("encompasses the end user"): on first run this generates
# a secp256k1 private key ON THIS MACHINE, stores it 0600 under
# <datadir>/keys/spend.pem, and records only the PUBLIC device fingerprint.
# The key is NEVER printed, logged, shipped in an image, or sent anywhere. A
# distributed image is identical for everyone; each install becomes the user's
# because its keys are born on the device. BACK UP spend.pem — it is the only copy.
#
#   Project: https://finux.tech      Coin: https://frostcoin.io
#
# Dependency-free except openssl (base on FreeBSD and openSUSE) for keygen.
#
set -eu

VERSION="0.1.0-stage1"
HOMEPAGE="https://finux.tech"
COIN="https://frostcoin.io"

DATADIR="/var/db/qoin"
INTERVAL=15
cmd="run"
WSUB="address"

usage() {
	cat <<EOF
qoind ${VERSION} — FrostOS Qoin core (Stage 1 scaffold)
usage: qoind [--datadir DIR] [--interval SECONDS] [run|status|init|wallet SUB]
       qoind --version
  run            supervise the data dir + heartbeat (default; used by rc.d/systemd)
  status         print node id, wallet fingerprint, last heartbeat
  init           create data dir, node id, and on-device wallet, then exit
  wallet init    generate the on-device wallet if absent (safe to re-run)
  wallet address print this device's public wallet fingerprint
  ${COIN}  ·  ${HOMEPAGE}
EOF
}

while [ $# -gt 0 ]; do
	case "$1" in
		--datadir)  DATADIR="$2"; shift 2 ;;
		--interval) INTERVAL="$2"; shift 2 ;;
		--version)  echo "qoind ${VERSION}  ${COIN}  ${HOMEPAGE}"; exit 0 ;;
		-h|--help)  usage; exit 0 ;;
		run|status|init) cmd="$1"; shift ;;
		wallet)     cmd="wallet"; shift
		            if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then WSUB="$1"; shift; fi ;;
		*) echo "qoind: unknown argument: $1" >&2; exit 2 ;;
	esac
done

KEYDIR="${DATADIR}/keys"

log() { logger -t qoind "$*" 2>/dev/null || true; printf 'qoind: %s\n' "$*"; }

sha256_hex() {  # portable sha256 of stdin -> lowercase hex
	if command -v sha256sum >/dev/null 2>&1; then sha256sum | cut -d' ' -f1
	elif command -v sha256 >/dev/null 2>&1; then sha256 -q
	elif command -v shasum >/dev/null 2>&1; then shasum -a 256 | cut -d' ' -f1
	else od -An -tx1 | tr -d ' \n'
	fi
}

new_node_id() {
	nid=$(dd if=/dev/urandom bs=16 count=1 2>/dev/null | sha256_hex 2>/dev/null || true)
	[ -n "$nid" ] || nid=$(hostname)$$
	printf 'FROST-%s\n' "$(printf '%s' "$nid" | cut -c1-16 | tr '[:lower:]' '[:upper:]')"
}

# Generate the on-device wallet if it does not exist. Idempotent and safe to
# re-run. The private key is never printed or logged.
ensure_wallet() {
	mkdir -p "${KEYDIR}"; chmod 0700 "${KEYDIR}" 2>/dev/null || true
	if [ -f "${KEYDIR}/spend.pem" ]; then return 0; fi
	if ! command -v openssl >/dev/null 2>&1; then
		log "openssl not found — wallet NOT provisioned. Install openssl, then: qoind wallet init"
		return 1
	fi
	( umask 077
	  openssl ecparam -name secp256k1 -genkey -noout -out "${KEYDIR}/spend.pem" 2>/dev/null ) || {
		log "wallet keygen failed (openssl secp256k1 unavailable?)"; return 1; }
	chmod 0600 "${KEYDIR}/spend.pem" 2>/dev/null || true
	openssl ec -in "${KEYDIR}/spend.pem" -pubout -out "${KEYDIR}/spend.pub" 2>/dev/null || true
	fp=$(openssl ec -in "${KEYDIR}/spend.pem" -pubout -outform DER 2>/dev/null \
	     | sha256_hex | cut -c1-16 | tr '[:lower:]' '[:upper:]')
	printf 'FROST-%s\n' "${fp}" > "${KEYDIR}/device.fpr"
	log "wallet provisioned on THIS device (FROST-${fp}). BACK UP ${KEYDIR}/spend.pem — it is the only copy."
}

init_datadir() {
	mkdir -p "${DATADIR}/state" "${DATADIR}/keys"
	chmod 0750 "${DATADIR}" 2>/dev/null || true
	if [ ! -f "${DATADIR}/state/node.id" ]; then
		new_node_id > "${DATADIR}/state/node.id"
		{
			printf 'created=%s\n' "$(date -u +%FT%TZ)"
			printf 'version=%s\n' "${VERSION}"
			printf 'homepage=%s\n' "${HOMEPAGE}"
		} > "${DATADIR}/state/node.meta"
		log "initialized ${DATADIR} (node $(cat "${DATADIR}/state/node.id"))"
	fi
	ensure_wallet || true
}

case "$cmd" in
	init)
		init_datadir
		;;
	wallet)
		case "$WSUB" in
			init)    ensure_wallet ;;
			address) cat "${KEYDIR}/device.fpr" 2>/dev/null || { echo "no wallet yet — run: qoind wallet init"; exit 1; } ;;
			*) echo "usage: qoind wallet [init|address]" >&2; exit 2 ;;
		esac
		;;
	status)
		if [ -f "${DATADIR}/state/heartbeat" ]; then
			echo "qoind   ${VERSION}"
			echo "node    $(cat "${DATADIR}/state/node.id" 2>/dev/null || echo unknown)"
			echo "wallet  $(cat "${KEYDIR}/device.fpr" 2>/dev/null || echo 'not provisioned')"
			echo "beat    $(cat "${DATADIR}/state/heartbeat")"
			echo "state   scaffold running — no network/consensus yet (Stage 3)"
			echo "links   ${COIN}  ${HOMEPAGE}"
		else
			echo "qoind: not running (no heartbeat under ${DATADIR}/state)"
			exit 1
		fi
		;;
	run)
		init_datadir
		log "starting ${VERSION} datadir=${DATADIR} interval=${INTERVAL}s"
		trap 'log "stopping"; exit 0' TERM INT
		while :; do
			date -u +%FT%TZ > "${DATADIR}/state/heartbeat"
			sleep "${INTERVAL}"
		done
		;;
esac
